[
  {
    "plugin_id": "herdr-plugin-workspace-manager",
    "name": "Workspace Manager",
    "version": "0.8.0",
    "min_herdr_version": "0.7.5",
    "description": "Declarative tab/pane layouts with per-workspace defaults applied automatically when a worktree is created.",
    "manifest_path": "/Users/gillesmajor/.config/herdr/plugins/github/herdr-plugin-workspace-manager-bf9e2ab2c0b6/herdr-plugin.toml",
    "plugin_root": "/Users/gillesmajor/.config/herdr/plugins/github/herdr-plugin-workspace-manager-bf9e2ab2c0b6",
    "enabled": true,
    "platforms": [
      "linux",
      "macos"
    ],
    "startup": [
      {
        "command": [
          "sh",
          "bin/herdr-workspace-manager",
          "startup"
        ]
      }
    ],
    "actions": [
      {
        "id": "apply",
        "title": "Apply workspace layout",
        "contexts": [
          "workspace"
        ],
        "command": [
          "sh",
          "bin/herdr-workspace-manager",
          "apply"
        ]
      },
      {
        "id": "remove-gone",
        "title": "Remove gone worktrees (preview)",
        "contexts": [
          "workspace"
        ],
        "command": [
          "sh",
          "bin/herdr-workspace-manager",
          "remove-gone",
          "--preview"
        ]
      },
      {
        "id": "validate",
        "title": "Validate workspace config",
        "command": [
          "sh",
          "bin/herdr-workspace-manager",
          "validate"
        ]
      }
    ],
    "events": [
      {
        "on": "workspace.created",
        "command": [
          "sh",
          "bin/herdr-workspace-manager",
          "event"
        ]
      },
      {
        "on": "workspace.focused",
        "command": [
          "sh",
          "bin/herdr-workspace-manager",
          "event"
        ]
      },
      {
        "on": "worktree.created",
        "command": [
          "sh",
          "bin/herdr-workspace-manager",
          "event"
        ]
      }
    ],
